# Visit notification (set in Vercel → Project → Settings → Environment Variables)
# Option A — email via Resend (recommended)
NOTIFY_EMAIL_TO=you@example.com
RESEND_API_KEY=re_xxxxxxxx
# Optional: use a verified domain sender in production (default: onboarding@resend.dev)
# NOTIFY_FROM_EMAIL=Portfolio <notifications@yourdomain.com>

# Option B — Discord/Slack webhook instead of email
# NOTIFY_WEBHOOK_URL=https://discord.com/api/webhooks/...
