# Visit notification — email via Resend (recommended)
NOTIFY_EMAIL_TO=you@example.com
RESEND_API_KEY=re_xxxxxxxx
# Optional: verified domain sender in production (default: onboarding@resend.dev)
# NOTIFY_FROM_EMAIL=Portfolio <notifications@yourdomain.com>

# Optional: Discord/Slack webhook instead of or in addition to email
# NOTIFY_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional: Upstash Redis free tier for server-side visit counting across devices
# https://upstash.com — free tier, no credit card for basic usage
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxx
